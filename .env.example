# Riot API (https://developer.riotgames.com) — development keys expire every 24 hours
RIOT_API_KEY=RGAPI-xxxxxxxx-xxxx-xxxx-xxxx-xxxxxxxxxxxx
RIOT_PLATFORM=euw1
RIOT_REGION=europe

# Agent mode: llm | bridge | b0   (default: llm if LLM_* is set, otherwise bridge)
# AGENT_MODE=bridge

# OpenAI-compatible model endpoint for llm mode (e.g. DeepSeek, Qwen)
# LLM_BASE_URL=https://api.deepseek.com/v1
# LLM_API_KEY=sk-...
# LLM_MODEL=deepseek-flash

# Client assistant (local League client, any server incl. 国服)
# LOL_INSTALL_DIR=D:\WeGameApps\英雄联盟\LeagueClient   # folder containing `lockfile`, only if auto-detection fails
# RIFTLENS_CLIENT_ASSISTANT=0                              # turn the background assistant off
